# Variáveis de ambiente — Exemplo

# Development (local)
VITE_API_URL=/api

# Production Railway (backend e frontend no mesmo serviço)
# Use URL relativa quando estiverem no mesmo domínio:
# VITE_API_URL=/api

# Production (GitHub Pages/Netlify/domínio separado) — API remota
# Exemplo Railway com backend público separado:
# VITE_API_URL=https://prescrimed-production.up.railway.app/api

# Backend root (sem /api) para healthcheck banner
# Quando backend for serviço separado, use o domínio público do backend
# VITE_BACKEND_ROOT=https://prescrimed-production.up.railway.app

# API Node (runtime - configure no host, nunca no frontend)
# Em producao, ambas sao obrigatorias.
# AUTH_TOKEN_SECRET=gere-uma-chave-longa-e-aleatoria
# CORS_ALLOWED_ORIGINS=https://cristiano-superacao.github.io
# DATABASE_URL=postgresql://usuario:senha@host:porta/banco
# PGSSLMODE=require

# Imagem de fundo opcional (login/registro)
# VITE_BG_IMAGE_URL=https://sua-imagem.exemplo/hero.jpg
